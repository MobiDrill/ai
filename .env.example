# Reference only: settings are read from process environment, not this file.
CONVERTER_URL=http://127.0.0.1:8001
# Use private local storage excluded from cloud sync and backups.
# CONVERSION_WORK_ROOT=C:\local-private\mobidrill-jobs
# Default: <project>/resources/static (persistent pipeline artifacts).
# PIPELINE_STORAGE_ROOT=C:\local-private\pipeline-files
MAX_FILE_BYTES=104857600
MAX_OUTPUT_BYTES=104857600
CONVERSION_TIMEOUT_SECONDS=60
MAX_CONCURRENT_CONVERSIONS=2
STALE_JOB_SECONDS=3600
